# EmailJS — RSVP → matheuspereira6464@gmail.com
# 1. Crie conta em https://www.emailjs.com/
# 2. Adicione um Email Service (ex.: Gmail) ligado à conta que envia
# 3. Crie um Email Template com os campos abaixo
#    Destinatário (To): matheuspereira6464@gmail.com
# 4. Copie este ficheiro para .env e preencha os IDs
# 5. No GitHub: Settings → Secrets and variables → Actions
#    adicione os mesmos três valores (usados no deploy Pages)

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Variáveis sugeridas no template EmailJS:
#   {{guest_name}}            — nome do convidado
#   {{guest_email}}           — e-mail do convidado
#   {{guest_phone}}           — telefone
#   {{attending}}             — "yes" ou "no"
#   {{attendance}}            — "SIM — estará presente" / "NÃO — não poderá comparecer"
#   {{attendance_decision}}   — igual a {{attendance}} (decisão clara)
#   {{notes}}                 — observações
#   {{reply_to}}              — e-mail para responder
#   {{to_email}}              — matheuspereira6464@gmail.com
